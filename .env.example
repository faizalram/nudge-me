# Generate the first six with: npm run secrets
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SESSION_SECRET=
CRON_SECRET=
INVITE_CODE=

# Added by the Neon integration in Vercel (Storage tab)
DATABASE_URL=

# From console.upstash.com > QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional, only if the QStash console shows one
QSTASH_URL=

# Optional: lets the app read times the built-in parser misses
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: only if you use a custom domain
APP_URL=
